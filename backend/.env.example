# Elever Performance Lab — backend configuration
# Copy to backend/.env and adjust. All values have safe development defaults.

# Port the Express API listens on.
PORT=4000

# Comma-separated list of allowed browser origins (the Next.js kiosk).
CORS_ORIGINS=http://localhost:3000

# HMAC secret used to sign kiosk + staff session tokens.
# MUST be set to a long random value in production.
AUTH_SECRET=dev-only-insecure-secret-change-me

# Session lifetimes (seconds). Kiosk sessions are short by design: the screen
# sits on a gym floor and should lock itself back to the scan prompt.
MEMBER_TOKEN_TTL=7200
ADMIN_TOKEN_TTL=3600

# Request logging: none | short | verbose
LOG_LEVEL=short
