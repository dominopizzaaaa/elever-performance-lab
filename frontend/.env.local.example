# Elever Performance Lab — kiosk configuration
# Copy to frontend/.env.local. Defaults work for local development.

# Where Next.js proxies /api/* requests (the Express backend).
API_PROXY_TARGET=http://localhost:4000

# Browser-side API base. Leave as /api to use the same-origin proxy above.
NEXT_PUBLIC_API_BASE_URL=/api

# Seconds of inactivity before the kiosk locks back to the scan screen.
# Set to 0 to disable auto-lock (handy while developing).
NEXT_PUBLIC_KIOSK_IDLE_TIMEOUT=600
